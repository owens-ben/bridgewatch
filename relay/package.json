{
  "name": "boat-ar-relay",
  "version": "0.1.0",
  "private": true,
  "description": "WebSocket relay between upstream feeds (AIS, MTA subway) and the Bridgewatch iOS app",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && jest",
    "start": "node dist/index.js",
    "record": "npm run build && node dist/record.js",
    "fixtures": "npm run build && node dist/tools/generate-fixtures.js",
    "subway-extract": "npm run build && node dist/tools/subway-extract.js",
    "check-edge": "npm run build && node dist/tools/check-edge.js",
    "census": "npm run build && node dist/tools/census-report.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/dist/**/*.test.js"
    ]
  },
  "dependencies": {
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "jest": "^30.5.2",
    "typescript": "^7.0.2"
  }
}
