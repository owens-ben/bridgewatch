AISSTREAM_API_KEY=
# Port the relay listens on inside the container. Leave at 8080 with docker compose; change RELAY_HOST_PORT instead.
PORT=8080
# Host port docker compose publishes the relay on; the app's RELAY_URL uses this port.
RELAY_HOST_PORT=8080
# Public edge (deploy/README.md, "Public edge"; relay/PROTOCOL.md, "Access"). The app token(s) the public listener
# asks for as `Authorization: Bearer <token>`: 16+ characters each, comma-separated during a rotation. Make one with
# `openssl rand -hex 24`. Without a valid one the public listener stays off.
APP_TOKEN=
# Port of the public listener. Never publish it on a host port: only cloudflared may reach it. Unset: no public listener.
PUBLIC_PORT=
